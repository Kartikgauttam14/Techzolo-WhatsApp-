PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/techzolo.sqlite
# Comma-separated exact sign-in emails allowed into the cross-company operator console.
# Configure this privately in .env; never use a tenant/workspace role as platform admin.
PLATFORM_ADMIN_EMAILS=
# Set NODE_ENV=production and serve behind HTTPS for Secure session cookies.
NODE_ENV=development
# Optional outbound email. Without SMTP, recovery/invitation emails are not sent.
SMTP_URL=
MAIL_FROM=Techzolo <hello@your-domain.com>
# Optional Stripe Billing. Create monthly recurring INR prices in Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Dedicated Meta app created for this product.
META_APP_ID=2618907555223678
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Facebook Login for Business > Configurations > WhatsApp Embedded Signup
META_LOGIN_CONFIG_ID=
# Generate unique values privately; never commit .env.
META_WEBHOOK_VERIFY_TOKEN=
# Optional separate HTTPS callback for a webhook-only development tunnel.
META_WEBHOOK_URL=
# 32 random bytes, base64 encoded. Keep stable and back it up securely.
WHATSAPP_ENCRYPTION_KEY=
# Developer/test connections only. Disable when Embedded Signup is live.
META_ALLOW_MANUAL_CONNECT=false
